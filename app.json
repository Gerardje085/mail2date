{
  "expo": {
    "name": "Mail2Date",
    "slug": "mail2date",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mail2dateai.png",
    "scheme": "myapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
